#!/usr/bin/env bash
# 本地守卫：禁止直接 push main（main 只接受 PR 合并）。
# 由 scripts/collab/install-hooks.sh 安装到 .git/hooks/pre-push。
# 应急放行：ALLOW_MAIN_PUSH=1 git push origin main
set -uo pipefail

[ "${ALLOW_MAIN_PUSH:-0}" = "1" ] && exit 0

protected=0
while read -r _local_ref local_sha remote_ref remote_sha; do
    [ -z "${remote_ref:-}" ] && continue
    case "$remote_ref" in
        refs/heads/main|refs/heads/master)
            # 内容没变（比如只是重推同一个 commit）不算违规
            if [ "${local_sha:-}" != "${remote_sha:-}" ]; then
                protected=1
            fi
            ;;
    esac
done

if [ "$protected" = "1" ]; then
    cat >&2 <<'EOF'
✗ 拒绝直接 push 到 main（collab 钩子）

  main 只接受 PR 合并。正确做法：
    git push -u origin HEAD        # 推你的任务分支
    gh pr create --fill            # 开 PR，等对方 review

  如果是紧急情况确实要直推：ALLOW_MAIN_PUSH=1 git push origin main
EOF
    exit 1
fi

exit 0
